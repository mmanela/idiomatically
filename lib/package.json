  "scripts": {
    "dev": "cross-env NODE_ENV=development node --conditions development server.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "build": "react-router build",
    "auth:smoke": "node server/scripts/authSmoke.mjs",
    "typecheck": "react-router typegen && tsc -b",
    "check": "npm run typecheck && npm run build",
    "codegen": "tsx server/scripts/genJoined.ts && graphql-codegen --config server/codegen.yml",
    "db:start": "docker compose -f ../docker-compose.yml up -d mongo",
    "db:stop": "docker compose -f ../docker-compose.yml stop mongo",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=22.22 <25"
  },
  "packageManager": "npm@11.6.2"
}
