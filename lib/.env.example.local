# Copy this file to .env.development.local only when overriding the committed
# local-development defaults.

# The urls for client and server
REACT_APP_SERVER=http://localhost:8000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8000

# The MongoDB connection string and database name
DB_CONNECTION=mongodb://localhost:27017
MONGO_DB=idiomatically

# Google credentials are only required to test sign-in
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_FOR_USER_AUTH
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET_FOR_USER_AUTH

# Admin emails (comma separated)
ADMIN_EMAILS=COMMA_SEPARATED_ADMIN_EMAILS

# (OPTIONAL) Application Insights connection key
APP_INSIGHTS_KEY=APP_INSIGHTS_KEY

# (OPTIONAL) SendGrid sends email notifications to admins
SENDGRID_API_KEY=SEND_GRID_EMAIL_KEY_FOR_ADMIN_NOTIFICATIONS