  "scripts": {
    "client:start": "react-app-rewired start",
    "client:build": "react-app-rewired build",
    "client:build:staging": "env-cmd --no-override -f .env.staging.local react-app-rewired build",
    "client:build:dev": "env-cmd --no-override -f .env.development.local react-app-rewired build",
    "client:test": "react-app-rewired test",
    "client:eject": "react-scripts eject",
    "client:schema": "apollo service:download ./src/schema.json",
    "client:types": "apollo client:codegen ./src/__generated__/types.ts --excludes=./src/index.tsx --includes=./src/**/*.tsx,./src/**/*.ts --addTypename --localSchemaFile=./src/schema.json --target=typescript --outputFlat",
    "client:pre": "npm run client:types",
    "server:start": "cross-env NODE_ENV=development TS_NODE_PROJECT=server/tsconfig.json nodemon -e ts,graphql --ignore server/_graphql/ -x node -r ts-node/register server/bootstrap.ts",
    "server:debug": "cross-env NODE_ENV=development TS_NODE_PROJECT=server/tsconfig.json nodemon -e ts,graphql --ignore server/_graphql/ -x node --inspect -r ts-node/register server/index.ts",
    "server:start:staging": "cross-env NODE_ENV=staging TS_NODE_PROJECT=server/tsconfig.json nodemon -e ts,graphql --ignore server/_graphql/ -x node -r ts-node/register server/bootstrap.ts",
    "server:debug:staging": "cross-env NODE_ENV=staging TS_NODE_PROJECT=server/tsconfig.json nodemon -e ts,graphql --ignore server/_graphql/ -x node --inspect -r ts-node/register server/bootstrap.ts",
    "server:ide": "cross-env NODE_ENV=development TS_NODE_PROJECT=server/tsconfig.json node --inspect -r ts-node/register server/index.ts",
    "server:schema": "cross-env TS_NODE_PROJECT=server/tsconfig.json ts-node ./server/scripts/genJoined.ts && apollo service:download --config=server/apollo.config.js ./src/schema.json",
    "server:types": "graphql-codegen --config ./server/codegen.yml",
    "server:pre": "npm run server:schema && npm run server:types",
    "server:prod": "cross-env NODE_ENV=production TS_NODE_PROJECT=server/tsconfig.json ts-node server/bootstrap.ts",
    "db:start": "docker compose -f ../docker-compose.yml up -d mongo",
    "db:stop": "docker compose -f ../docker-compose.yml stop mongo",
    "predev": "npm run db:start",
    "dev": "concurrently --kill-others --names server,client --prefix-colors blue,green \"npm run server:start\" \"npm run client:start\"",
    "build": "npm run server:pre && npm run client:pre && npm run client:build",
    "check": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "webpack": "5.111.1"
  }
}
