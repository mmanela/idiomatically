# Optional overrides
COPILOT_CLI_PATH=copilot
# Per-research-call timeout in milliseconds; minimum 30000.
COPILOT_RESEARCH_TIMEOUT_MS=180000
IDIOMATICALLY_GRAPHQL_URL=https://idiomatically.net/graphql

# Required only for `import --apply`. Copy the Cookie request header from an
# authenticated contributor or administrator browser session.
IDIOMATICALLY_SESSION_COOKIE=__Secure-idiomatically.session_token=SESSION_VALUE
